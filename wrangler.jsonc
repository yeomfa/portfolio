{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omaryesid-dev",
  "compatibility_date": "2026-10-01",
  // A static site: no Worker script, only the built pages in dist.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    // /en and /proyectos/acuda are served from en.html and proyectos/acuda.html.
    "html_handling": "auto-trailing-slash",
  },
  "workers_dev": true,
  // Enabled in the dashboard too; deploys from the repo would turn it off without this.
  "observability": {
    "enabled": true,
  },
  // Both hostnames point at this Worker. A Cloudflare Redirect Rule sends
  // www.omaryesid.dev to https://omaryesid.dev (301) before the request reaches it.
  "routes": [
    { "pattern": "omaryesid.dev", "custom_domain": true },
    { "pattern": "www.omaryesid.dev", "custom_domain": true },
  ],
}
