{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omaryesid-dev",
  "compatibility_date": "2026-10-01",
  // A static site: no Worker script, only the built pages in dist.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    // /en and /proyectos/acuda are served from en.html and proyectos/acuda.html.
    "html_handling": "auto-trailing-slash",
  },
  "workers_dev": true,
  // Once omaryesid.dev is an active zone in this Cloudflare account, uncomment:
  // "routes": [
  //   { "pattern": "omaryesid.dev", "custom_domain": true },
  //   { "pattern": "www.omaryesid.dev", "custom_domain": true },
  // ],
}
